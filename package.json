{
  "name": "boopstick",
  "version": "0.0.0",
  "private": true,
  "description": "Pure comparison of explicit UI obligations against declared observations",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=24", "bun": ">=1.4.3" },
  "packageManager": "bun@1.4.3",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": { "boopstick": "./dist/cli.js" },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "skills/boopstick/SKILL.md",
    "skills/boopstick/references/contract.md",
    "skills/boopstick/references/tools-and-evidence.md",
    "docs/provenance.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "bun tests/check.ts && node tests/package-check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
